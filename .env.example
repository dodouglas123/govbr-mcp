GOVBR_ENVIRONMENT=local
GOVBR_PUBLIC_URL=http://localhost:8787
GOVBR_PORT=8787
GOVBR_PANEL_PORT=8788
# Gere uma senha alfanumérica longa usando infrastructure/scripts/init.ps1 ou init.sh.
GOVBR_DB_PASSWORD=
GOVBR_CGU_KEY=
GOVBR_REQUESTS_PER_MINUTE=45
GOVBR_QUERY_CONCURRENCY=5
GOVBR_TIME_LIMIT_SECONDS=25
GOVBR_HISTORY_DAYS=30
GOVBR_EVIDENCE_DAYS=180
GOVBR_DOCUMENT_MAX_MIB=10
# OAuth opcional. Preencha os valores abaixo em conjunto.
# GOVBR_OAUTH_ISSUER=https://auth.seudominio.com/realms/govbr
# GOVBR_OAUTH_JWKS_URL=https://auth.seudominio.com/realms/govbr/protocol/openid-connect/certs
# GOVBR_OAUTH_AUDIENCE=https://mcp.seudominio.com/mcp
# GOVBR_OAUTH_ALLOWED_SUBJECTS=identificador-sub-no-provedor
# GOVBR_OAUTH_ALGORITHMS=RS256
# TLS público no perfil https, após apontar o DNS.
# GOVBR_DOMAIN=mcp.seudominio.com
